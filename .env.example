# =====================================================================
# VARIABLES DE ENTORNO - E-COMMERCE BERSAJ (AWS EC2 / DOCKER)
# =====================================================================

# Modo Django (True para desarrollo/laboratorio, False para producción estricta)
DEBUG=True

# Clave secreta de la aplicación
SECRET_KEY=bersaj-secret-key-aws-2026-production

# Modo de notificación (CELERY para tareas asíncronas en background, MOCK para pruebas)
EMAIL_MODE=CELERY

# Strangler Fig Pattern: Activar microservicio de catálogo e inventario
USE_CATALOG_MICROSERVICE=true
CATALOG_SERVICE_URL=http://flask_catalog:5001

# Message Broker (Redis)
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Modo del adaptador de divisas (REAL para consumir open.er-api.com, MOCK para determinista)
EXCHANGE_API_MODE=REAL

# =====================================================================
# INTEGRACIÓN EQUIPO ALIADO (Requerimiento 2.3)
# =====================================================================
# Reemplazar con la URL / IP pública del equipo aliado cuando esté disponible:
# Ejemplo: http://54.210.123.45:80
ALLY_SERVICE_URL=http://fake-ally-service
